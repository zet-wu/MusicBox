{
  "name": "musicbox-renderer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "serve": "vite preview --port 8080",
    "lint": "npm run check:architecture && eslint src/**/*.js",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "clean": "rimraf public",
    "build:css": "sass src/styles/main.scss public/styles/main.css --style=compressed"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.5.2",
    "@applemusic-like-lyrics/lyric": "1.0.2",
    "@applemusic-like-lyrics/ttml": "1.0.1",
    "@tanstack/virtual-core": "3.17.7",
    "dayjs": "^1.11.7",
    "fuzzball": "2.2.6",
    "lru-cache": "11.5.2",
    "opencc-js": "^1.4.1",
    "p-queue": "9.3.3",
    "pako": "2.1.0"
  },
  "devDependencies": {
    "@types/pako": "2.0.4",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@xmldom/xmldom": "0.9.11",
    "chokidar": "^3.6.0",
    "concurrently": "^7.6.0",
    "esbuild": "^0.28.0",
    "eslint": "9.26.0",
    "http-server": "^14.1.1",
    "rimraf": "^4.1.2",
    "sass": "^1.58.3",
    "terser": "^5.16.6",
    "typescript": "^6.0.3",
    "vite": "8.0.5",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.10"
  }
}
